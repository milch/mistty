<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Xcode's Memory Graph Debugger to attach via `task_for_pid`.
         Dev builds only — the release `bundle-release` recipe does not pass
         these entitlements, so production users' apps remain non-debuggable
         by third parties. -->
    <key>com.apple.security.get-task-allow</key>
    <true/>
</dict>
</plist>
