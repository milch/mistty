+/// Mistty patch: freeze the viewport where it is. `.active` becomes `.pin`
+/// at the active area's top-left so new output flows into scrollback without
+/// shifting visible content. No-op when already `.top`/`.pin` or when there
+/// is no scrollback (same guard as `scroll`).
+pub fn pinViewport(self: *PageList) void {
+    defer self.assertIntegrity();
+    if (self.limits.bytes.explicit == 0) return;
+    switch (self.viewport) {
+        .top, .pin => return,
+        .active => {},
+    }
+    self.viewport_pin.* = self.getTopLeft(.active);
+    self.viewport = .pin;
+    self.viewport_pin_row_offset = null;
+    self.page_compression.reset();
+    self.page_compression.markActivity();
+}
