+    /// Mistty patch: pin the viewport at its current position without
+    /// scrolling. Transitions the viewport from `.active` mode (which
+    /// auto-follows the live edge so streaming output keeps the latest
+    /// content visible) to `.pin` mode (anchored at a specific row, so new
+    /// output goes into scrollback). Used by Mistty's copy mode to "freeze"
+    /// the view on entry without the visible content shifting — the
+    /// existing `scroll_page_lines:-N` binding always causes at least one
+    /// row of upward shift, which is jarring when the user wasn't
+    /// actively scrolling. No-op when the viewport is already `.pin` or
+    /// `.top`, or when the screen has no scrollback (alternate screen in
+    /// vim/less/etc. — `PageList.scroll` early-returns in that case to
+    /// keep the viewport stuck at `.active`; mirror that invariant here).
+    /// Requires holding the renderer mutex because it mutates
+    /// rendering-relevant state; queues a render so the new viewport state
+    /// reaches the renderer thread on the next frame.
+    export fn ghostty_surface_pin_viewport(surface: *Surface) void {
+        const core = &surface.core_surface;
+        core.renderer_state.mutex.lockUncancelable(global.io());
+        defer core.renderer_state.mutex.unlock(global.io());
+        core.io.terminal.screens.active.pages.pinViewport();
+        core.renderer_thread.wakeup.notify() catch {};
+    }
